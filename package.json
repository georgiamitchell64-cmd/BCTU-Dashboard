{
  "name": "tonic-dashboard",
  "version": "1.0.0",
  "description": "TONIC Trial Dashboard \u2014 Desktop App",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win dir"
  },
  "author": "Birmingham Clinical Trials Unit",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "chart.js": "^4.4.0",
    "rcedit": "^5.0.2"
  },
  "overrides": {
    "@noble/hashes": "^1.4.0"
  },
  "build": {
    "appId": "uk.ac.bham.bctu.tonic-dashboard",
    "productName": "TONIC Dashboard",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "build/after-pack.js",
      "build/icon.*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TONIC Dashboard",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "afterPack": "build/after-pack.js"
  }
}