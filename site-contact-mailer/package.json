{
  "name": "site-contact-mailer",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop app for importing a site contact list from Excel and emailing site contacts",
  "author": "Birmingham Clinical Trials Unit",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "sample": "node sample/make-sample.js",
    "icon": "node tools/make-icon.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "rcedit": "^5.0.2",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "uk.ac.bham.bctu.site-contact-mailer",
    "productName": "Site Contact Mailer",
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.test.js"
    ],
    "directories": {
      "output": "dist"
    },
    "afterPack": "build/after-pack.js",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Site Contact Mailer",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
