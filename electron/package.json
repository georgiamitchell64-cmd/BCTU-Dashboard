{
  "name": "bctu-dashboard",
  "productName": "BCTU Dashboard",
  "version": "1.0.0",
  "description": "BCTU Clinical Trials Dashboard — desktop build",
  "private": true,
  "main": "main.js",
  "author": "Birmingham Clinical Trials Unit",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "stage": "cd ../BCTU_Clinical_Trials_Dashboard && Rscript scripts/prepare_distribution.R ../dist-staging --force",
    "predist": "npm run stage",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "uk.ac.bham.bctu.dashboard",
    "productName": "BCTU Dashboard",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": [
      "main.js",
      "loading.html",
      "lib/**/*",
      "build/icon.*",
      "!test/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist-staging",
        "to": "app",
        "filter": ["**/*", "!mockups/**", "!tests/**", "!**/backups/**"]
      },
      { "from": "runtime", "to": "runtime" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BCTU Dashboard"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.medical"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "Science"
    }
  }
}
