{
  "name": "bctu-planner",
  "productName": "BCTU Planner",
  "version": "1.0.0",
  "description": "A desktop day-to-day planner for clinical trial work — daily, weekly and monthly tasks with urgency, trial tagging and full customisation.",
  "author": "Birmingham Clinical Trials Unit",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"test/*.test.mjs\"",
    "preview": "node tools/preview-server.js",
    "icon": "node tools/make-icon.js",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "planner",
    "tasks",
    "electron",
    "clinical-trials",
    "bctu"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^24.13.3",
    "rcedit": "^5.0.2",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "uk.ac.bham.bctu.planner",
    "productName": "BCTU Planner",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "afterPack": "build/after-pack.js",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "BCTU Planner",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
